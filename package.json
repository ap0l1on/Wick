{
  "name": "wick",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wick — free daily browser game. Name the asset behind a famous market moment in 5 guesses.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:data": "tsx --test tests/transform.test.ts",
    "test": "vitest run",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "test:e2e": "playwright test",
    "lint": "eslint src scripts tests e2e",
    "build:puzzles": "tsx scripts/build-puzzles.ts --swap",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "preact": "^10.24.3",
    "yahoo-finance2": "^4.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "@preact/preset-vite": "^2.10.1",
    "@types/node": "^22.20.4",
    "eslint": "^9.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vite": "^8.3.0",
    "vitest": "^2.1.8"
  },
  "main": "eslint.config.js",
  "directories": {
    "test": "tests"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ap0l1on/Wick.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/ap0l1on/Wick/issues"
  },
  "homepage": "https://github.com/ap0l1on/Wick#readme"
}
